{
  "name": "blockblast",
  "main": "expo-router/entry",
  "version": "1.1.42",
  "dependencies": {
    "@appmetrica/react-native-analytics": "^4.1.0",
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/unbounded": "^0.4.1",
    "expo": "~56.0.20",
    "expo-asset": "~56.0.17",
    "expo-audio": "~56.0.13",
    "expo-constants": "~56.0.18",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.6",
    "expo-gl": "~56.0.6",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.12",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.17",
    "expo-localization": "~56.0.6",
    "expo-notifications": "~56.0.24",
    "expo-router": "~56.2.19",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-reanimated": "4.3.1",
    "react-native-rustore-push": "git+https://git@gitflic.ru/project/rustore/react-native-rustore-push-sdk.git",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
