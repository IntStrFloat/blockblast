    "yandex-mobile-ads": "^8.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/jest": "~29.5.14",
    "@types/react": "~19.2.2",
    "@types/three": "^0.162.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.5",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "backend:build": "tsc -p backend/tsconfig.engine.json",
    "backend:test": "npm run backend:build && node --test backend/__tests__/*.test.cjs",
    "postinstall": "patch-package"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest-setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/worktrees/",
      "<rootDir>/.worktrees/"
    ]
  },
  "private": true
}
