{
  "expo": {
    "name": "Bloxx",
    "slug": "blockblast",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "blockblast",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1B33",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.intstrfloat.blockblast"
    },
    "android": {
      "package": "com.intstrfloat.blockblast",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0F1B33",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1B33",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-audio",
      "expo-localization",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
