{
  "expo": {
    "name": "Блок Бластик! Block Blast",
    "slug": "blockblast",
    "version": "1.1.46",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "blockblast",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1348",
    "android": {
      "package": "com.intstrfloat.blockblast",
      "versionCode": 51,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1348",
          "image": "./assets/night-candy/capy.png",
          "imageWidth": 120
        }
      ],
      "expo-audio",
      "expo-localization",
      "expo-asset",
      "expo-notifications",
      "./plugins/withHuaweiAgconnect",
      "./plugins/withAppMetrica",
      "./plugins/withYandexVkMediation",
      "./plugins/withRuStorePush",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "platforms": [
      "android"
    ]
  }
}
