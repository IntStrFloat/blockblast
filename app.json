{
  "expo": {
    "name": "Блок Бластик! Block Blast",
    "slug": "blockblast",
    "version": "1.1.42",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "blockblast",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1B33",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.intstrfloat.blockblast",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.intstrfloat.blockblast",
      "versionCode": 47,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1B33",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-audio",
      "expo-localization",
      "expo-asset",
      "expo-notifications",
      "./plugins/withHuaweiAgconnect",
      "./plugins/withAppMetrica",
      "./plugins/withYandexVkMediation",
      "./plugins/withRuStorePush",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
